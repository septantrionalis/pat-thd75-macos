[server]
listen_host = 127.0.0.1
listen_port = 8000
callsign = N0CALL

[client.0]
name = TH-D75 USB 1200
type = serial
device = /dev/cu.usbmodemXXXX
serial_baudrate = 9600
ota_baudrate = 1200
ax25_version = 2.0
parity = N
stopbits = 1
rtscts = false
send_kiss_exit = false

[kiss.0]
tx_delay = 30
persistence = 128
slot_time = 10
tx_tail = 3
full_duplex = 0
